# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...).
# SERVER ONLY. Never prefix it with VITE_ and never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Any long random string. Protects /api/cron (Vercel sends it automatically).
CRON_SECRET=change-me-to-a-long-random-string

# Optional: run non-JavaScript languages on your own Piston server instead of
# the public Wandbox service. https://github.com/engineer-man/piston
# PISTON_URL=https://piston.example.com
# PISTON_TOKEN=
# WANDBOX_URL=https://wandbox.org
