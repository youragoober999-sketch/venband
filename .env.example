# Copy to .env.local and fill in from Supabase dashboard -> Project Settings -> API.
# Both values are safe to publish: every table is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional TURN server for users behind strict NATs (media stays end-to-end encrypted).
# VITE_TURN_URL=turns:turn.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
