# Copy to .env.local and fill in from Supabase dashboard -> Project Settings -> API.
# Both values are safe to publish: every table is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional smart translation server endpoint / provider
# Client will fall back to offline phrasebook if not set.
# VITE_SMART_TRANSLATE_URL=/api/translate
# 
# API-side translation provider (used by /api/translate)
# TRANSLATE_PROVIDER=deepl  # or 'google'
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
