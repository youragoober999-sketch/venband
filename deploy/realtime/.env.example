# Copy to .env and fill in. Nothing here is secret: the anon key is the public one
# the website already ships. Never put the service-role key on this server.
REALTIME_DOMAIN=rt.venband.com
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Only these sites may connect (comma-separated). The desktop app loads venband.com;
# the phone apps use https://localhost (Android) and venband://localhost (iOS).
ALLOW_ORIGINS=https://venband.com,https://www.venband.com,https://localhost,venband://localhost
